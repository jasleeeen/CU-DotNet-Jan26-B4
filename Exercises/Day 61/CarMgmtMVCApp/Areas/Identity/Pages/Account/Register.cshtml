@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<style>
    body {
        background: linear-gradient(135deg, #141e30, #243b55);
        overflow: hidden;
    }

    .bg-glow {
        position: absolute;
        width: 500px;
        height: 500px;
        background: radial-gradient(circle, rgba(0,123,255,0.3), transparent);
        top: -100px;
        left: -100px;
        z-index: 0;
    }

    .container-center {
        min-height: 90vh;
        display: flex;
        justify-content: center;
        align-items: center;
        position: relative;
        z-index: 1;
    }

    .glass-card {
        backdrop-filter: blur(15px);
        background: rgba(255, 255, 255, 0.08);
        border-radius: 20px;
        padding: 35px;
        width: 100%;
        max-width: 420px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
        color: white;
        animation: fadeInUp 0.6s ease;
    }

    .glass-card h2 {
        font-weight: 600;
    }

    .form-control {
        background: rgba(255,255,255,0.1);
        border: none;
        color: white;
        border-radius: 10px;
    }

    .form-control::placeholder {
        color: #ccc;
    }

    .form-control:focus {
        box-shadow: 0 0 10px rgba(0,123,255,0.5);
        background: rgba(255,255,255,0.15);
        color: white;
    }

    .btn-premium {
        border-radius: 10px;
        background: linear-gradient(45deg, #007bff, #00c6ff);
        border: none;
        transition: all 0.3s ease;
    }

    .btn-premium:hover {
        transform: scale(1.05);
        box-shadow: 0 0 15px rgba(0,123,255,0.6);
    }

    label {
        color: #ddd;
    }

    a {
        color: #00c6ff;
    }

</style>

<div class="bg-glow"></div>

<div class="container-center">
    <div class="glass-card">

        <h2 class="text-center">✨ Create Account</h2>
        <p class="text-center text-light">Join the Car Management System</p>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" placeholder="Email" />
                <label>Email</label>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.Password" class="form-control" placeholder="Password" />
                <label>Password</label>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.ConfirmPassword" class="form-control" placeholder="Confirm Password" />
                <label>Confirm Password</label>
            </div>

            <div class="form-floating mb-3">
                <select asp-for="Input.Role" class="form-control">
                    <option value="User">User</option>
                    <option value="Customer">Customer</option>
                </select>
                <label>Select Role</label>
            </div>

            <button type="submit" class="w-100 btn btn-lg btn-premium">
                Register
            </button>

            <div class="text-center mt-3">
                <a asp-page="./Login">Already have an account? Login</a>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}