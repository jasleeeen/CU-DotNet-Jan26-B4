@model IEnumerable<WebApplicationAssets.Models.Investment>

@{
    ViewData["Title"] = "Investments";
    var totalValue = ViewBag.TotalValue ?? 0m;
}

<div class="container py-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h1 class="h3 m-0">Investments</h1>
        <a asp-action="Create" class="btn btn-primary">Create New</a>
    </div>

    <div class="row mb-3 g-3">
        <div class="col-sm-6 col-md-3">
            <div class="card p-3">
                <div class="text-muted">Holdings</div>
                <div class="h4 mt-1">@Model.Count()</div>
            </div>
        </div>
        <div class="col-sm-6 col-md-6">
            <div class="card p-3">
                <div class="text-muted">Total Value</div>
                <div class="h4 mt-1">₹@String.Format("{0:N2}", totalValue)</div>
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table id="investTable" class="table table-striped table-hover table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.TickerSymbol)</th>
                    <th>@Html.DisplayNameFor(model => model.AssetName)</th>
                    <th>@Html.DisplayNameFor(model => model.PurchasePrice)</th>
                    <th>@Html.DisplayNameFor(model => model.Quantity)</th>
                    <th>@Html.DisplayNameFor(model => model.PurchaseDate)</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.TickerSymbol</td>
                        <td>@item.AssetName</td>
                        <td>@String.Format("₹{0:N2}", item.PurchasePrice)</td>
                        <td>@item.Quantity</td>
                        <td>@item.PurchaseDate</td>
                        <td>@String.Format("₹{0:N2}", item.PurchasePrice * item.Quantity)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(function () {
            $('#investTable').DataTable({
                pageLength: 10,
                lengthChange: false,
                order: [[1, 'asc']],
                // columnDefs: [{ targets: [2, 3, 5], className: 'text-end' }]
            });
        });
    </script>
}
