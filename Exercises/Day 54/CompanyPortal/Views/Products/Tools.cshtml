            </tr>
            <tr>
                <td>Deployment Manager</td>
                <td>Automates application deployment</td>
                <td><span class="badge bg-info">Premium</span></td>
            </tr>
            <tr>
                <td>Testing Toolkit</td>
                <td>Automated testing for applications</td>
                <td><span class="badge bg-success">Free</span></td>
            </tr>
        </tbody>
    </table>
</div>