@{
    ViewData["Title"] = "Home Page";
}

<div class="jumbotron">
    <h1 class="display-4">Home Page</h1>
    <p class="lead">
        This page uses different bootstrap components including jumbotron and cards.
    </p>
    <hr class="my-4">
    <p>This entire section is a jumbotron</p>

    <div class="position-fixed top-0 end-0 p-3">
        <div class="toast" id="liveToast" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-body">
                Hello! This is a toast message.
                <div class="mt-2 pt-2 border-top">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="toast">
                        Close
                    </button>
                </div>
            </div>
        </div>
    </div>
    <button type="button" class="btn btn-primary" id="liveToastBtn">
        Show toast
    </button>
</div>

<br />
<br />

<div class="card-group">
    <div class="card">
        <img src="/downloadcsharp.png" class="card-img-top" alt="C#" height="250">
        <div class="card-body">
            <h5 class="card-title">C# Tutorials</h5>
            <a href="https://www.w3schools.com/cs/index.php" class="card-link">Click here</a>
        </div>
    </div>

    <div class="card">
        <img src="/downloadcpp.png" class="card-img-top" alt="C++" height="250">
        <div class="card-body">
            <h5 class="card-title">C++ Tutorials</h5>
            <a href="https://www.w3schools.com/cpp/default.asp" class="card-link">Click here</a>
        </div>
    </div>

    <div class="card">
        <img src="/downloadjava.png" class="card-img-top" alt="Java" height="250">
        <div class="card-body">
            <h5 class="card-title">Java Tutorials</h5>
            <a href="https://www.w3schools.com/java/" class="card-link">Click here</a>
        </div>
    </div>

    <div class="card">
        <img src="/downloadpy.jpg" class="card-img-top" alt="Python" height="250">
        <div class="card-body">
            <h5 class="card-title">Python Tutorials</h5>
            <a href="https://www.w3schools.com/python/" class="card-link">Click here</a>
        </div>
    </div>
</div>

<script>
    const toastBtn = document.getElementById("liveToastBtn");
    const toastElement = document.getElementById("liveToast");
    toastBtn.addEventListener("click", function () {
        const toast = new bootstrap.Toast(toastElement);
        toast.show();
    });
</script>