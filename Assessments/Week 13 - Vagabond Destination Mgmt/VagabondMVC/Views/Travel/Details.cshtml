@model VagabondMVC.Models.Destination

@{
    ViewData["Title"] = "Details";
}

<h1>Destination Details</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">City</dt>
        <dd class="col-sm-10">@Model?.CityName</dd>

        <dt class="col-sm-2">Country</dt>
        <dd class="col-sm-10">@Model?.Country</dd>

        <dt class="col-sm-2">Description</dt>
        <dd class="col-sm-10">@Model?.Description</dd>

        <dt class="col-sm-2">Rating</dt>
        <dd class="col-sm-10">@Model?.Rating</dd>

        <dt class="col-sm-2">Last Visited</dt>
        <dd class="col-sm-10">@Model?.LastVisited.ToString("f")</dd>
    </dl>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>