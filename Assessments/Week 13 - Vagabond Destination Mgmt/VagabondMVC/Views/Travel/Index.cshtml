@model IEnumerable<VagabondMVC.Models.Destination>

@{
    ViewData["Title"] = "Travel Destinations";
}

<style>
    body {
        background-color: #121212 !important;
    }
    .destination-card {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
        border: 1px solid #333;
        border-radius: 12px;
        background-color: #1e1e1e !important;
    }
    .destination-card h4, .destination-card h6, .destination-card p, .destination-card small {
        color: #e0e0e0 !important;
    }
    .destination-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(255,255,255,0.05) !important;
    }
    .text-gradient {
        background: linear-gradient(45deg, #00c6ff, #007bff);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        font-weight: bold;
    }
</style>

<div class="d-flex justify-content-between align-items-center mt-4 mb-4">
    <h1 class="display-5 text-gradient">Travel Destinations</h1>
    <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm">
        + Create New
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-pill bg-dark text-success border-success" role="alert">
        <strong>Success!</strong> @TempData["SuccessMessage"]
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row row-cols-1 row-cols-md-3 g-4 pb-5">
@foreach (var item in Model) {
    <div class="col">
        <div class="card h-100 shadow-sm destination-card" style="cursor: pointer;" onclick="location.href='@Url.Action("Details", new { id = item.Id })'">
            <div class="card-body d-flex flex-column">
                <h4 class="card-title fw-bold mb-1">@item.CityName</h4>
                <h6 class="card-subtitle mb-3 text-secondary">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-geo-alt-fill text-danger me-1" viewBox="0 0 16 16">
                        <path d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10zm0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6z"/>
                    </svg>@item.Country
                </h6>
                <p class="card-text mb-4">
                    <span class="badge bg-warning text-dark mb-2 px-2 py-1 border border-warning">
                        ⭐ Rating: @item.Rating / 5
                    </span> 
                    <br />
                    <small class="text-secondary">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-calendar-event me-1" viewBox="0 0 16 16">
                            <path d="M11 6.5a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5v-1z"/>
                            <path d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5zM1 4v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4H1z"/>
                        </svg>
                        <strong>Visited:</strong> @item.LastVisited.ToString("f")
                    </small>
                </p>
                <div class="mt-auto d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm flex-fill rounded-pill fw-semibold" onclick="event.stopPropagation();">Edit</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info btn-sm flex-fill rounded-pill fw-semibold" onclick="event.stopPropagation();">Details</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm flex-fill rounded-pill fw-semibold" onclick="event.stopPropagation();">Delete</a>
                </div>
            </div>
        </div>
    </div>
}
</div>
